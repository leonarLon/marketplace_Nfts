# Ativa a camada MSW (REST + Socket.IO simulados). Necessário no dev e no build de demonstração.
VITE_ENABLE_MOCKS=true
# Base das APIs REST (interceptadas pelo MSW quando os mocks estão ativos).
VITE_API_URL=/api
# Endpoint Socket.IO (interceptado pelo MSW via @mswjs/socket.io-binding).
VITE_SOCKET_URL=wss://realtime.kurio.test
# Timeout das requisições HTTP em ms.
VITE_HTTP_TIMEOUT=8000
